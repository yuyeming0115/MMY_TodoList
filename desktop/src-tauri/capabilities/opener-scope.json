{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "opener-scope",
  "description": "Allow opening SnippingTool for screenshot",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$RESOURCE/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPCACHE/**" },
        { "path": "$APPLOG/**" },
        { "path": "$TEMP/**" },
        { "path": "C:\\Windows\\System32\\SnippingTool.exe" },
        { "path": "C:\\Windows\\System32\\SnippingTool.exe" }
      ]
    }
  ]
}